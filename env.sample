# Core runtime
DATABASE_URL=postgresql://user:password@host:5432/pentagon
PORT=3000
NODE_ENV=production

# Authentication
SESSION_SECRET=replace_with_long_random_secret
ADMIN_PASSWORD=replace_with_admin_password
ADMIN_EMAIL=admin@example.com
ADMIN_EMAIL_WHITELIST=admin@example.com
DEMO_PASSWORD=replace_with_demo_password

# Monitoring
CHECK_INTERVAL_SECONDS=60
STATUS_KEYWORDS=internetpositif,trustpositif,nawala
ALERT_COOLDOWN_MINUTES=5
DIGEST_INTERVAL_MINUTES=60
HOURLY_DIGEST_MINUTES=60
DOMAIN_CHECK_CONCURRENCY=5
RANK_CHECK_INTERVAL_MINUTES=20
TRUSTPOSITIF_ON_DIRECT_WARNING=true
DOMAIN_RADAR_DASHBOARD_URL=https://pentagon.example.com

# Telegram
TELEGRAM_BOT_TOKEN=replace_with_bot_token
TELEGRAM_CHAT_ID=replace_with_chat_id

# AI / SEO audit
OPENAI_API_KEY=

# Provider node agent defaults (only needed by provider-node deployments)
PROVIDER_NAME=
NETWORK_TYPE=
AGENT_SECRET=
AGENT_PORT=3001
